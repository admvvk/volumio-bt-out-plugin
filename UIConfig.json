{
  "page": {
    "label": "TRANSLATE.BT_OUT.PLUGIN_NAME"
  },
  "sections": [
    {
      "id": "section_bluetooth",
      "element": "section",
      "label": "TRANSLATE.BT_OUT.SECTION_TITLE",
      "description": "TRANSLATE.BT_OUT.SECTION_DESC",
      "icon": "fa-bluetooth",
      "onSave": {
        "type": "controller",
        "endpoint": "audio_interface/volumio-bt-out-plugin",
        "method": "saveBluetoothConfig"
      },
      "saveButton": {
        "label": "TRANSLATE.BT_OUT.SAVE",
        "data": ["enabled", "deviceMac", "deviceName"]
      },
      "content": [
        {
          "id": "usageNotice",
          "element": "input",
          "doc": "TRANSLATE.BT_OUT.NOTICE_DOC",
          "label": "TRANSLATE.BT_OUT.NOTICE_LABEL",
          "element_subtype": "text",
          "value": "TRANSLATE.BT_OUT.NOTICE_TEXT",
          "attributes": [{"readonly": true}]
        },
        {
          "id": "scanDevices",
          "element": "button",
          "label": "TRANSLATE.BT_OUT.SCAN",
          "doc": "TRANSLATE.BT_OUT.SCAN_DOC",
          "onClick": {
            "type": "plugin",
            "endpoint": "audio_interface/volumio-bt-out-plugin",
            "method": "scanForDevices"
          }
        },
        {
          "id": "enabled",
          "element": "switch",
          "label": "TRANSLATE.BT_OUT.ENABLE",
          "doc": "TRANSLATE.BT_OUT.ENABLE_DOC",
