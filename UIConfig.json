          "options": []
        },
        {
          "id": "deviceName",
          "element": "input",
          "doc": "TRANSLATE.BT_OUT.NAME_DOC",
          "label": "TRANSLATE.BT_OUT.NAME",
          "element_subtype": "text",
          "value": "",
          "attributes": [{"readonly": true}]
        },
        {
          "id": "connectionStatus",
          "element": "input",
          "doc": "TRANSLATE.BT_OUT.STATUS_DOC",
          "label": "TRANSLATE.BT_OUT.STATUS",
          "element_subtype": "text",
          "value": "",
          "attributes": [{"readonly": true}]
        }
      ]
    }
  ]
}
